ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Only the MiniLM worker carries PyTorch; web, collector and TF-IDF stay small.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 180 --index-url https://download.pytorch.org/whl/cpu 'torch==2.14.0+cpu' \
    && pip install --timeout 180 'transformers==4.57.6' 'safetensors==0.8.0'

ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=1
CMD ["python", "-m", "app.taxonomy.worker"]
